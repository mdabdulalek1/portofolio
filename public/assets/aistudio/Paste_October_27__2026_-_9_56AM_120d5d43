<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#07090e">
  <meta name="description" content="Md. Abdul Alek — Computer Engineering Technologist, Full-Stack Web & App Developer, Server Administrator, and AI Solutions Architect.">
  <meta name="author" content="Md. Abdul Alek">
  <title>Md. Abdul Alek — Digital Engineering & AI Solutions</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>

  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            obsidian: '#07090E',
            cyan: '#06B6D4',
            amber: '#F59E0B'
          },
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace']
          }
        }
      }
    };
  </script>

  <style>
    :root {
      --bg: #07090E;
      --surface: rgba(17, 24, 39, .7);
      --border: rgba(255, 255, 255, .085);
      --cyan: #06B6D4;
      --amber: #F59E0B;
      --muted: #9299aa;
    }

    * { box-sizing: border-box; }

    html {
      scroll-behavior: smooth;
      scroll-padding-top: 100px;
    }

    body {
      margin: 0;
      background: var(--bg);
      color: #f5f7fb;
      font-family: 'Plus Jakarta Sans', sans-serif;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }

    ::selection {
      color: #061016;
      background: var(--cyan);
    }

    a { color: inherit; text-decoration: none; }

    button, input, select, textarea { font: inherit; }

    button, a { -webkit-tap-highlight-color: transparent; }

    .mono {
      font-family: 'JetBrains Mono', monospace;
      letter-spacing: -.035em;
    }

    .muted { color: var(--muted); }

    .container-main {
      width: min(1160px, calc(100% - 44px));
      margin-inline: auto;
    }

    .grid-bg {
      background-image:
        linear-gradient(rgba(255,255,255,.023) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,.023) 1px, transparent 1px);
      background-size: 48px 48px;
      mask-image: linear-gradient(to bottom, black, transparent 90%);
    }

    .glass {
      background: var(--surface);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid var(--border);
    }

    .glow {
      position: absolute;
      border-radius: 50%;
      filter: blur(110px);
      pointer-events: none;
      z-index: 0;
    }

    .text-gradient {
      background: linear-gradient(110deg, #f8fafc 10%, #67e8f9 65%, #06b6d4);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .amber-gradient {
      background: linear-gradient(120deg, #fde68a, #f59e0b);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .section {
      padding-block: 112px;
      position: relative;
    }

    .section-label {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      color: #67e8f9;
      font: 500 11px 'JetBrains Mono', monospace;
      letter-spacing: .13em;
      text-transform: uppercase;
    }

    .section-label::before {
      content: "";
      width: 22px;
      height: 1px;
      background: var(--cyan);
    }

    .section-title {
      margin-top: 19px;
      font-size: clamp(32px, 5vw, 51px);
      font-weight: 800;
      letter-spacing: -.065em;
      line-height: 1.13;
    }

    .section-desc {
      max-width: 610px;
      margin-top: 18px;
      color: var(--muted);
      font-size: 15px;
      line-height: 1.9;
    }

    .navbar {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      z-index: 100;
      border-bottom: 1px solid transparent;
      transition: background .25s, border-color .25s;
    }

    .navbar.scrolled {
      background: rgba(7, 9, 14, .88);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-color: var(--border);
    }

    .nav-inner {
      min-height: 78px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 25px;
    }

    .brand {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      flex-shrink: 0;
      font-weight: 800;
      letter-spacing: -.055em;
      font-size: 20px;
    }

    .brand-mark {
      width: 35px;
      height: 35px;
      display: grid;
      place-items: center;
      border: 1px solid rgba(6,182,212,.45);
      border-radius: 10px;
      color: var(--cyan);
      background: rgba(6,182,212,.08);
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 27px;
    }

    .nav-links a {
      color: #a6adbb;
      font-size: 12px;
      font-weight: 600;
      transition: color .2s;
    }

    .nav-links a:hover { color: white; }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 9px;
      min-height: 48px;
      padding: 0 20px;
      border: 1px solid transparent;
      border-radius: 10px;
      font-size: 13px;
      font-weight: 700;
      transition: transform .2s, box-shadow .2s, background .2s, border-color .2s;
      cursor: pointer;
    }

    .btn:hover { transform: translateY(-2px); }

    .btn-primary {
      background: var(--cyan);
      color: #041116;
      box-shadow: 0 0 28px rgba(6,182,212,.12);
    }

    .btn-primary:hover {
      background: #67e8f9;
      box-shadow: 0 0 35px rgba(6,182,212,.25);
    }

    .btn-secondary {
      background: rgba(255,255,255,.025);
      color: #f4f7fb;
      border-color: var(--border);
    }

    .btn-secondary:hover {
      background: rgba(255,255,255,.06);
      border-color: rgba(6,182,212,.4);
    }

    .menu-toggle {
      display: none;
      width: 42px;
      height: 42px;
      border: 1px solid var(--border);
      border-radius: 10px;
      color: white;
      background: var(--surface);
      align-items: center;
      justify-content: center;
    }

    .hero {
      min-height: 780px;
      padding-top: 158px;
      padding-bottom: 75px;
      display: flex;
      align-items: center;
      overflow: hidden;
    }

    .hero-layout {
      display: grid;
      grid-template-columns: 1.12fr .88fr;
      align-items: center;
      gap: 65px;
      position: relative;
      z-index: 1;
    }

    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      border: 1px solid var(--border);
      background: rgba(255,255,255,.035);
      padding: 9px 13px;
      border-radius: 7px;
      color: #c3cad5;
      font: 10px 'JetBrains Mono', monospace;
      line-height: 1.7;
    }

    .status-dot {
      width: 7px;
      height: 7px;
      background: #4ade80;
      border-radius: 50%;
      box-shadow: 0 0 13px rgba(74,222,128,.7);
      flex-shrink: 0;
    }

    .hero h1 {
      margin-top: 29px;
      font-size: clamp(43px, 5.5vw, 69px);
      font-weight: 800;
      line-height: 1.075;
      letter-spacing: -.075em;
    }

    .hero-copy {
      margin-top: 23px;
      max-width: 585px;
      font-size: 15px;
      line-height: 1.95;
      color: #a7afbf;
    }

    .hero-copy strong { color: white; }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 31px;
    }

    .hero-code {
      position: relative;
      min-width: 0;
      border-radius: 17px;
      padding: 23px;
      overflow: hidden;
      transform: rotate(1deg);
      box-shadow: 0 30px 100px rgba(0,0,0,.3);
    }

    .hero-code::before {
      content: "";
      position: absolute;
      width: 210px;
      height: 210px;
      border-radius: 50%;
      right: -75px;
      top: -100px;
      background: rgba(6,182,212,.15);
      filter: blur(65px);
    }

    .window-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid var(--border);
      padding-bottom: 17px;
      position: relative;
    }

    .window-dots { display: flex; gap: 6px; }

    .window-dots span {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #465064;
    }

    .window-dots span:first-child { background: #f87171; }
    .window-dots span:nth-child(2) { background: #fbbf24; }
    .window-dots span:nth-child(3) { background: #4ade80; }

    .window-file {
      color: #a8b0c0;
      font: 10px 'JetBrains Mono', monospace;
    }

    .code-content {
      position: relative;
      padding-top: 19px;
      font: 11px/2.25 'JetBrains Mono', monospace;
      overflow-x: auto;
    }

    .code-line {
      display: grid;
      grid-template-columns: 25px minmax(0,1fr);
      gap: 8px;
      white-space: pre;
    }

    .line-number { color: #515c70; user-select: none; }
    .syntax-purple { color: #c4b5fd; }
    .syntax-cyan { color: #67e8f9; }
    .syntax-green { color: #86efac; }
    .syntax-amber { color: #fcd34d; }
    .syntax-muted { color: #7e899d; }

    .code-bottom {
      margin-top: 20px;
      padding: 15px;
      border: 1px solid var(--border);
      background: rgba(0,0,0,.18);
      border-radius: 10px;
      display: flex;
      justify-content: space-between;
      gap: 10px;
      align-items: center;
    }

    .code-bottom strong {
      display: block;
      font-size: 12px;
      margin-top: 5px;
    }

    .code-bottom small {
      color: #8c96a9;
      font: 9px 'JetBrains Mono', monospace;
    }

    .terminal-status {
      color: #4ade80;
      font: 10px 'JetBrains Mono', monospace;
    }

    .floating-chip {
      position: absolute;
      right: -18px;
      bottom: -26px;
      display: flex;
      align-items: center;
      gap: 11px;
      padding: 13px 16px;
      border-radius: 12px;
      font-size: 11px;
      box-shadow: 0 20px 45px rgba(0,0,0,.35);
      animation: float 5s ease-in-out infinite;
    }

    .floating-chip i {
      color: #4ade80;
      width: 20px;
    }

    .floating-chip strong { display: block; font-size: 12px; }
    .floating-chip small { display: block; margin-top: 3px; color: var(--muted); }

    .hero-stats {
      display: grid;
      grid-template-columns: repeat(4, minmax(0,1fr));
      gap: 12px;
      margin-top: 67px;
      position: relative;
      z-index: 2;
    }

    .stat-card {
      padding: 19px 17px;
      border-radius: 11px;
      min-width: 0;
    }

    .stat-number {
      font-size: clamp(19px, 2.3vw, 27px);
      font-weight: 800;
      letter-spacing: -.06em;
      overflow-wrap: anywhere;
    }

    .stat-label {
      margin-top: 9px;
      color: #929bad;
      font-size: 10px;
      line-height: 1.7;
    }

    .capability-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0,1fr));
      gap: 16px;
      margin-top: 49px;
    }

    .capability-card {
      position: relative;
      padding: 28px;
      border-radius: 14px;
      overflow: hidden;
      transition: transform .25s, border-color .25s, box-shadow .25s;
    }

    .capability-card::after {
      content: "";
      position: absolute;
      top: -70px;
      right: -70px;
      width: 160px;
      height: 160px;
      background: rgba(6,182,212,.07);
      filter: blur(55px);
      border-radius: 50%;
      pointer-events: none;
    }

    .capability-card:hover {
      transform: translateY(-5px);
      border-color: rgba(6,182,212,.38);
      box-shadow: 0 20px 65px rgba(0,0,0,.2);
    }

    .icon-box {
      width: 49px;
      height: 49px;
      border-radius: 12px;
      display: grid;
      place-items: center;
      color: #67e8f9;
      background: rgba(6,182,212,.09);
      border: 1px solid rgba(6,182,212,.17);
    }

    .capability-card h3 {
      margin-top: 23px;
      font-size: 19px;
      font-weight: 700;
      letter-spacing: -.045em;
    }

    .capability-card p {
      margin-top: 13px;
      font-size: 13px;
      line-height: 1.9;
      color: #9da6b6;
    }

    .tags {
      display: flex;
      flex-wrap: wrap;
      gap: 7px;
      margin-top: 21px;
    }

    .tag {
      display: inline-block;
      padding: 7px 9px;
      border-radius: 5px;
      background: rgba(255,255,255,.035);
      border: 1px solid rgba(255,255,255,.065);
      color: #aab4c6;
      font: 9px 'JetBrains Mono', monospace;
    }

    .projects-section { background: #090c13; }

    .project-filters {
      display: flex;
      flex-wrap: wrap;
      gap: 9px;
      margin-top: 34px;
    }

    .filter-btn {
      padding: 10px 14px;
      border-radius: 7px;
      background: transparent;
      border: 1px solid var(--border);
      color: #9da6b6;
      cursor: pointer;
      font-size: 11px;
      font-weight: 600;
      transition: .2s;
    }

    .filter-btn:hover,
    .filter-btn.active {
      color: #67e8f9;
      background: rgba(6,182,212,.08);
      border-color: rgba(6,182,212,.4);
    }

    .projects-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0,1fr));
      gap: 17px;
      margin-top: 28px;
    }

    .project-card {
      min-width: 0;
      overflow: hidden;
      border-radius: 13px;
      transition: transform .25s, border-color .25s;
    }

    .project-card:hover {
      transform: translateY(-5px);
      border-color: rgba(6,182,212,.4);
    }

    .project-card[hidden] { display: none; }

    .project-image {
      position: relative;
      aspect-ratio: 1.45;
      overflow: hidden;
      background: #121926;
    }

    .project-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform .5s, opacity .3s;
      opacity: .83;
    }

    .project-card:hover .project-image img {
      transform: scale(1.06);
      opacity: 1;
    }

    .project-number {
      position: absolute;
      left: 13px;
      top: 13px;
      background: rgba(7,9,14,.82);
      border: 1px solid rgba(255,255,255,.12);
      padding: 6px 8px;
      border-radius: 5px;
      font: 9px 'JetBrains Mono', monospace;
      color: #d0d6e2;
    }

    .project-body { padding: 19px; }

    .project-category {
      color: #67e8f9;
      font: 9px 'JetBrains Mono', monospace;
      text-transform: uppercase;
      letter-spacing: .07em;
    }

    .project-body h3 {
      margin-top: 11px;
      font-size: 15px;
      font-weight: 700;
      line-height: 1.6;
      letter-spacing: -.025em;
    }

    .project-body p {
      margin-top: 10px;
      color: #98a2b3;
      font-size: 11px;
      line-height: 1.9;
    }

    .project-foot {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      padding-top: 15px;
      margin-top: 16px;
      border-top: 1px solid var(--border);
      color: #8e98aa;
      font: 9px 'JetBrains Mono', monospace;
    }

    .project-foot i { width: 15px; color: var(--cyan); }

    .pipeline {
      margin-top: 54px;
      display: grid;
      grid-template-columns: repeat(4, minmax(0,1fr));
      gap: 13px;
    }

    .pipeline-card {
      padding: 23px 19px;
      border-radius: 12px;
      position: relative;
    }

    .pipeline-card .step {
      font: 10px 'JetBrains Mono', monospace;
      color: var(--cyan);
    }

    .pipeline-card h3 {
      font-size: 15px;
      font-weight: 700;
      line-height: 1.55;
      margin-top: 22px;
    }

    .pipeline-card p {
      color: #98a2b3;
      font-size: 11px;
      line-height: 1.9;
      margin-top: 13px;
    }

    .pipeline-card .step-icon {
      margin-top: 23px;
      color: #68758a;
      width: 23px;
    }

    .pipeline-card:hover .step-icon { color: var(--cyan); }

    .about-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 58px;
      align-items: start;
      margin-top: 48px;
    }

    .about-copy {
      color: #a2abba;
      font-size: 13px;
      line-height: 2.05;
    }

    .about-copy strong { color: #f5f7fb; }

    .about-highlight {
      border-left: 2px solid var(--cyan);
      padding: 17px 20px;
      margin-top: 25px;
      background: rgba(6,182,212,.045);
      color: #c6cfdb;
      font-size: 12px;
      line-height: 1.9;
    }

    .credential-panel {
      padding: 25px;
      border-radius: 14px;
    }

    .panel-heading {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 13px;
      font-weight: 700;
    }

    .panel-heading i { color: var(--cyan); width: 18px; }

    .credential-item {
      display: grid;
      grid-template-columns: 36px minmax(0,1fr);
      gap: 13px;
      padding: 18px 0;
      border-bottom: 1px solid var(--border);
    }

    .credential-item:last-child { border-bottom: 0; }

    .credential-icon {
      width: 34px;
      height: 34px;
      display: grid;
      place-items: center;
      color: #67e8f9;
      background: rgba(6,182,212,.08);
      border-radius: 8px;
    }

    .credential-icon i { width: 16px; }

    .credential-item h4 {
      font-size: 12px;
      line-height: 1.7;
      font-weight: 700;
    }

    .credential-item p {
      margin-top: 5px;
      color: #929bad;
      font-size: 10px;
      line-height: 1.8;
    }

    .stack-title {
      margin-top: 28px;
      font-size: 12px;
      font-weight: 700;
    }

    .stack-tags { margin-top: 15px; }

    .contact-section { background: #090c13; }

    .contact-grid {
      display: grid;
      grid-template-columns: .85fr 1.15fr;
      gap: 50px;
      margin-top: 46px;
      align-items: start;
    }

    .contact-copy {
      margin-top: 18px;
      color: #9ba5b6;
      font-size: 13px;
      line-height: 1.9;
    }

    .contact-list {
      display: grid;
      gap: 12px;
      margin-top: 27px;
    }

    .contact-item {
      display: flex;
      gap: 14px;
      align-items: flex-start;
      padding: 16px;
      border-radius: 10px;
    }

    .contact-item .icon-box {
      width: 41px;
      height: 41px;
      flex-shrink: 0;
    }

    .contact-item small {
      display: block;
      color: #8d97aa;
      font: 9px 'JetBrains Mono', monospace;
      text-transform: uppercase;
      letter-spacing: .08em;
    }

    .contact-item strong {
      display: block;
      font-size: 12px;
      line-height: 1.7;
      margin-top: 5px;
      overflow-wrap: anywhere;
    }

    .contact-item p {
      margin-top: 4px;
      color: #929bad;
      font-size: 10px;
    }

    .social-links {
      display: flex;
      gap: 9px;
      margin-top: 20px;
    }

    .social-link {
      width: 41px;
      height: 41px;
      border-radius: 9px;
      display: grid;
      place-items: center;
      border: 1px solid var(--border);
      color: #b4bdca;
      transition: .2s;
    }

    .social-link:hover {
      color: var(--cyan);
      border-color: rgba(6,182,212,.45);
      background: rgba(6,182,212,.07);
    }

    .inquiry-form {
      border-radius: 15px;
      padding: 29px;
    }

    .form-title {
      font-size: 17px;
      font-weight: 700;
      letter-spacing: -.035em;
    }

    .form-subtitle {
      color: #919bad;
      font-size: 11px;
      line-height: 1.8;
      margin-top: 8px;
      margin-bottom: 23px;
    }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0,1fr));
      gap: 17px;
    }

    .field { min-width: 0; }
    .field.full { grid-column: 1 / -1; }

    .field label {
      display: block;
      margin-bottom: 8px;
      font-size: 11px;
      color: #c4ccda;
      font-weight: 600;
    }

    .field input,
    .field select,
    .field textarea {
      width: 100%;
      min-width: 0;
      padding: 12px 13px;
      border-radius: 8px;
      color: #f5f7fb;
      background: rgba(255,255,255,.035);
      border: 1px solid rgba(255,255,255,.1);
      outline: none;
      font-size: 12px;
      transition: border-color .2s, box-shadow .2s;
    }

    .field input:focus,
    .field select:focus,
    .field textarea:focus {
      border-color: rgba(6,182,212,.7);
      box-shadow: 0 0 0 3px rgba(6,182,212,.07);
    }

    .field select { color-scheme: dark; }
    .field textarea { min-height: 118px; resize: vertical; line-height: 1.8; }
    .field input::placeholder, .field textarea::placeholder { color: #667084; }

    .form-footer {
      margin-top: 19px;
      display: flex;
      flex-wrap: wrap;
      gap: 13px;
      align-items: center;
      justify-content: space-between;
    }

    .form-note {
      color: #818c9f;
