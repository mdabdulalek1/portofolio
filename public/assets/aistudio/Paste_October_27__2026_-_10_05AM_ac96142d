<script src="https://unpkg.com/lucide@latest"></script>

<style>
:root{
  --bg:#faf9f6;
  --ink:#111111;
  --yellow:#ffbd20;
  --muted:#66635f;
  --line:#dedbd4;
  --white:#fff;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:85px}
body{
  margin:0;background:var(--bg);color:var(--ink);
  font-family:"DM Sans",sans-serif;
}
a{color:inherit;text-decoration:none}
button,input,textarea,select{font:inherit}
button{cursor:pointer}
.wrap{width:min(1200px,92%);margin:auto}
header{
  position:sticky;top:0;z-index:20;
  background:rgba(250,249,246,.92);
  backdrop-filter:blur(14px);
  border-bottom:1px solid rgba(0,0,0,.06);
}
nav{height:75px;display:flex;align-items:center;justify-content:space-between;gap:20px}
.logo{font-size:21px;font-weight:800;letter-spacing:-1.4px}
.logo span{color:#d99a00}
.navlinks{display:flex;align-items:center;gap:27px;font-size:12px;font-weight:700}
.navlinks a:hover{color:#b67e00}
.nav-cta,.primary{
  background:var(--yellow);color:#111;border:0;
  padding:13px 20px;border-radius:5px;
  font-size:12px;font-weight:800;display:inline-flex;
  align-items:center;justify-content:center;gap:8px;
  transition:.2s;
}
.nav-cta:hover,.primary:hover{background:#f4a900;transform:translateY(-2px)}
.menu{display:none;background:none;border:0}
.hero{
  position:relative;overflow:hidden;padding:70px 0 32px;
}
.hero:before{
  content:"";position:absolute;right:-100px;top:-150px;
  width:56%;height:680px;background:var(--yellow);
  border-radius:48% 0 0 45%;transform:rotate(-7deg);
}
.hero:after{
  content:"";position:absolute;left:-130px;top:-170px;
  width:320px;height:250px;background:#171717;
  border-radius:0 0 65% 0;
}
.hero-grid{
  position:relative;z-index:1;
  display:grid;grid-template-columns:1fr .95fr;
  gap:35px;align-items:center;
}
.intro{font-family:Caveat,cursive;color:#e7a500;font-size:38px}
h1{
  font-family:Oswald,sans-serif;text-transform:uppercase;
  font-size:clamp(54px,7vw,92px);line-height:.99;
  letter-spacing:-2px;margin:12px 0 20px;
}
.role{
  display:inline-block;background:var(--yellow);
  padding:8px 12px;font-size:12px;font-weight:800;
  text-transform:uppercase;letter-spacing:.5px;
}
.hero h2{font-size:23px;line-height:1.5;margin:23px 0 12px;letter-spacing:-.7px}
.yellow{color:#d99a00}
.description{font-size:13px;color:#484641;line-height:1.95;max-width:440px}
.hero-buttons{display:flex;gap:12px;flex-wrap:wrap;margin-top:24px}
.secondary{
  border:1px solid #bdb8ad;padding:12px 18px;
  border-radius:5px;font-size:12px;font-weight:800;
}
.secondary:hover{background:#fff}
.portrait{
  position:relative;display:flex;justify-content:center;
  align-items:center;min-height:420px;
}
.portrait img{
  position:relative;z-index:1;width:100%;max-width:490px;
  height:480px;object-fit:cover;object-position:center 25%;
  mix-blend-mode:multiply;filter:grayscale(1) contrast(1.12);
  -webkit-mask-image:linear-gradient(to bottom,#000 78%,transparent 100%);
  mask-image:linear-gradient(to bottom,#000 78%,transparent 100%);
}
.portrait-label{
  position:absolute;right:0;bottom:35px;z-index:2;
  background:#fff;padding:13px 17px;border-radius:4px;
  box-shadow:0 8px 25px #0000000d;font-size:11px;
}
.portrait-label strong{display:block;font-size:13px;margin-bottom:4px}
.social-row{display:flex;align-items:center;gap:10px;margin-top:25px}
.social{
  width:34px;height:34px;border-radius:50%;background:#111;color:#fff;
  display:grid;place-items:center;transition:.2s
}
.social:hover{background:#d99a00;transform:translateY(-3px)}
.social i{width:16px;height:16px}
.social-caption{border-left:1px solid var(--line);padding-left:16px;font-size:11px;font-weight:700}
.services{
  position:relative;z-index:3;background:#fff;border:1px solid #e9e5dd;
  border-radius:17px;padding:25px 15px;margin-top:10px;
  display:grid;grid-template-columns:repeat(4,1fr);
  box-shadow:0 12px 35px #0000000c;
}
.service{padding:5px 22px;border-right:1px solid var(--line)}
.service:last-child{border:0}
.service-icon{
  width:47px;height:47px;border-radius:50%;background:var(--yellow);
  display:grid;place-items:center;margin:0 auto 14px;
}
.service-icon i{width:22px;height:22px}
.service h3{text-align:center;font-size:13px;margin:0 0 12px;font-weight:800}
.service ul{padding-left:15px;margin:0;font-size:10px;line-height:2.1;color:#444}
.details{
  display:grid;grid-template-columns:.85fr 1.15fr;
  gap:45px;padding:35px 5px 30px;
}
.section-heading{
  font-size:13px;text-transform:uppercase;font-weight:800;
  margin:0 0 20px;
}
.section-heading span{color:#d99a00}
.underline{width:34px;height:3px;background:var(--yellow);margin-top:-12px;margin-bottom:17px}
.highlights{list-style:none;padding:0;margin:0}
.highlights li{
  display:flex;align-items:flex-start;gap:10px;
  font-size:11px;margin:12px 0;line-height:1.7
}
.check{
  width:16px;height:16px;border-radius:50%;background:var(--yellow);
  display:grid;place-items:center;flex-shrink:0;margin-top:1px
}
.check i{width:11px;height:11px}
.tools{border-left:1px solid var(--line);padding-left:30px}
.tool-grid{display:grid;grid-template-columns:repeat(4,54px);gap:12px}
.tool{
  width:54px;height:54px;background:#fff;border:1px solid #eee9e1;
  border-radius:7px;display:grid;place-items:center;
  font-size:13px;font-weight:800;transition:.2s
}
.tool:hover{transform:translateY(-3px);border-color:var(--yellow)}
.tool i{width:23px;height:23px}
.quote{
  font-family:Caveat,cursive;font-size:23px;line-height:1.35;
  margin:20px 0 0;color:#35332f
}
.quote span{color:#d99a00}
.projects{padding:35px 0 65px}
.section-top{display:flex;justify-content:space-between;gap:20px;align-items:end}
.section-top h2{
  font-family:Oswald,sans-serif;font-size:36px;
  text-transform:uppercase;margin:8px 0;letter-spacing:-.5px
}
.eyebrow{font-size:10px;text-transform:uppercase;letter-spacing:2px;font-weight:800;color:#a77800}
.filters{display:flex;gap:7px;flex-wrap:wrap;margin:22px 0}
.filter{
  background:transparent;border:1px solid #d8d2c7;border-radius:4px;
  padding:9px 12px;font-size:10px;font-weight:700
}
.filter.active,.filter:hover{background:var(--yellow);border-color:var(--yellow)}
.project-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:17px}
.project{background:white;border:1px solid #ebe7df;border-radius:9px;overflow:hidden;transition:.25s}
.project:hover{transform:translateY(-4px);box-shadow:0 12px 30px #0000000a}
.project[hidden]{display:none}
.project img{display:block;width:100%;height:190px;object-fit:cover;background:#eee}
.project-content{padding:17px}
.project-category{font-size:9px;font-weight:800;color:#a77800;text-transform:uppercase;letter-spacing:1px}
.project h3{font-size:14px;line-height:1.6;margin:9px 0}
.project p{font-size:11px;line-height:1.8;color:#68645e;margin:0}
.project-foot{border-top:1px solid #eee9e1;margin-top:14px;padding-top:12px;display:flex;justify-content:space-between;font-size:10px;font-weight:700}
.project-foot i{width:16px}
.about{padding:60px 0}
.about-grid{display:grid;grid-template-columns:1fr 1fr;gap:45px;align-items:start}
.about h2{font-family:Oswald,sans-serif;font-size:43px;line-height:1.13;text-transform:uppercase;margin:14px 0}
.about p{font-size:13px;color:#55514b;line-height:2}
.about strong{color:#111}
.credentials{background:#fff;border:1px solid #ebe7df;border-radius:10px;padding:24px}
.credential{display:flex;gap:13px;padding:15px 0;border-bottom:1px solid #eee9e1}
.credential:last-child{border:0}
.credential-icon{background:#fff3cf;padding:10px;height:39px;border-radius:6px}
.credential-icon i{width:18px;height:18px}
.credential h3{font-size:12px;margin:0 0 6px}
.credential p{font-size:10px;margin:0;line-height:1.8}
.stack{display:flex;flex-wrap:wrap;gap:7px;margin-top:18px}
.stack span{font-size:10px;background:#f7f5f0;padding:8px 10px;border-radius:4px}
.contact{padding:20px 0 35px}
.contact-panel{
  background:#171717;color:#fff;border-radius:19px;
  padding:28px;position:relative;overflow:hidden
}
.contact-panel:after{
  content:"";position:absolute;right:-25px;bottom:-65px;
  width:150px;height:150px;border:1px dotted #ffbd20;border-radius:50%
}
.contact-heading{font-size:11px;color:var(--yellow);font-weight:800;text-transform:uppercase;letter-spacing:1px}
.contact-row{display:grid;grid-template-columns:1fr 1fr 1fr;gap:20px;margin-top:18px;position:relative;z-index:1}
.contact-item{display:flex;align-items:center;gap:12px;min-width:0;border-right:1px solid #555;padding-right:15px}
.contact-item:last-child{border:0}
.contact-icon{width:37px;height:37px;background:var(--yellow);color:#111;display:grid;place-items:center;border-radius:4px;flex-shrink:0}
.contact-icon i{width:18px}
.contact-item strong{font-size:11px;overflow-wrap:anywhere}
.contact-item small{display:block;color:var(--yellow);font-size:9px;margin-top:6px;line-height:1.6}
.contact-item a:hover{color:var(--yellow)}
.contact-form{margin-top:22px;position:relative;z-index:1}
.contact-form summary{font-size:11px;font-weight:800;cursor:pointer;color:var(--yellow)}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:16px}
.form-grid input,.form-grid select,.form-grid textarea{
  width:100%;padding:12px;border:1px solid #454545;background:#242424;
  color:white;border-radius:4px;font-size:11px
}
.form-grid textarea{grid-column:1/-1;min-height:90px;resize:vertical}
.form-grid button{justify-self:start}
footer{text-align:center;padding:18px 0 27px}
.footer-title{font-family:Oswald,sans-serif;font-size:23px;letter-spacing:5px;font-weight:600}
.footer-title span{color:#d99a00}
.footer-sub{font-size:9px;letter-spacing:2px;margin-top:8px}
.footer-copy{font-size:10px;color:#777;margin-top:16px}
.reveal{animation:enter .7s both}
@keyframes enter{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
@media(min-width:1000px){.hero-grid{min-height:475px}}
@media(max-width:850px){
  .navlinks{gap:14px}.hero-grid{grid-template-columns:1fr .8fr;gap:18px}
  .portrait img{height:390px}.services{grid-template-columns:repeat(2,1fr);gap:18px}
  .service:nth-child(2){border-right:0}.service:nth-child(-n+2){padding-bottom:18px;border-bottom:1px solid var(--line)}
  .project-grid{grid-template-columns:repeat(2,1fr)}
  .contact-row{grid-template-columns:1fr}.contact-item{border-right:0;border-bottom:1px solid #555;padding:0 0 14px}
}
@media(max-width:600px){
  .wrap{width:91%}
  nav{height:65px}.menu{display:block}
  .navlinks{
    display:none;position:absolute;top:65px;left:0;right:0;
    background:var(--bg);padding:18px 5%;border-bottom:1px solid var(--line);
    flex-direction:column;align-items:stretch
  }
  .navlinks.open{display:flex}
  .navlinks a{padding:10px 0}
  .nav-cta{display:none}
  .hero{padding-top:42px}
  .hero:before{top:310px;right:-170px;width:90%;height:410px}
  .hero:after{width:180px;height:130px;left:-80px;top:-90px}
  .hero-grid{grid-template-columns:1fr;gap:5px}
  .intro{font-size:32px}
  h1{font-size:clamp(55px,13vw,77px)}
  .hero h2{font-size:21px}
  .description{font-size:12px}
  .portrait{min-height:300px;margin-top:10px}
  .portrait img{height:340px;max-width:390px}
  .portrait-label{right:0;bottom:18px}
  .services{margin-top:12px;padding:18px 7px;gap:15px}
  .service{padding:5px 10px}
  .service h3{font-size:11px}
  .service ul{font-size:9px;padding-left:12px}
  .service-icon{width:42px;height:42px}
  .details{grid-template-columns:1fr;gap:25px;padding-top:30px}
  .tools{border-left:0;border-top:1px solid var(--line);padding:25px 0 0}
  .tool-grid{grid-template-columns:repeat(4,48px);gap:9px}
  .tool{width:48px;height:48px}
  .project-grid{grid-template-columns:1fr}
  .project img{height:210px}
  .section-top{align-items:start;flex-direction:column}
  .section-top h2{font-size:31px}
  .about-grid{grid-template-columns:1fr;gap:25px}
  .about h2{font-size:37px}
  .contact-panel{padding:22px 18px}
  .form-grid{grid-template-columns:1fr}
  .form-grid textarea{grid-column:auto}
  .footer-title{font-size:21px}
}
@media(prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  *,*::before,*::after{animation:none!important;transition:none!important}
}
</style>
</head>

